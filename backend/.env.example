# ────────────────────────────────────────────────────────────────────────────
# PRODUCTION CHECKLIST (before deploy):
#   1. Replace DATABASE_URL with the real MongoDB Atlas connection string
#   2. Generate a strong JWT_SECRET:      openssl rand -hex 32
#   3. Generate a PII_ENCRYPTION_KEY:     openssl rand -base64 32
#   4. Set CORS_ORIGINS to exact HTTPS origins (NO localhost, NO wildcards)
#   5. Set ENABLE_SWAGGER=false (re-enable only behind VPN/Basic Auth if needed)
#   6. Set NODE_ENV=production
#   7. Health probe path for orchestrator: GET /api/health  (liveness)
#                                         GET /api/health/ready  (readiness)
# ────────────────────────────────────────────────────────────────────────────

DATABASE_URL="mongodb+srv://user:password@cluster0.example.mongodb.net/guru_credits?retryWrites=true&w=majority"
HOST=0.0.0.0
PORT=3001

JWT_SECRET="replace-with-strong-secret"
JWT_EXPIRES_IN="7d"
PII_ENCRYPTION_KEY="replace-with-base64-32-byte-secret"

# Comma-separated HTTPS origins (required in production — NO wildcards).
# Example prod value: "https://guru-credit.com,https://admin.guru-credit.com"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# Must be "false" in production unless Swagger is gated behind VPN/Basic Auth.
ENABLE_SWAGGER=true

# Optional: write structured logs to this file (path resolved from backend/)
LOG_FILE="logs/api.log"

# SMTP mailer (leave blank to log emails to console)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_SECURE=false
SMTP_FROM="GURU Credits <no-reply@guru-credit.com>"

COMPANY_WHATSAPP="+601127486389"
