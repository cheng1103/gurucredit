NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_SITE_URL="https://guru-credit.com"

# CSP (optional, appended to default policy)
NEXT_PUBLIC_CSP_CONNECT_SRC=""
NEXT_PUBLIC_CSP_IMG_SRC=""
NEXT_PUBLIC_CSP_SCRIPT_SRC=""
NEXT_PUBLIC_CSP_STYLE_SRC=""
NEXT_PUBLIC_CSP_FRAME_SRC=""
NEXT_PUBLIC_CSP_REPORT_URI=""
NEXT_PUBLIC_CSP_REPORT_TO=""
NEXT_PUBLIC_CSP_REPORT_ONLY="false"

# Search engine verification
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""

# Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Locale URL migration (see docs/LOCALE_MIGRATION_PLAN.md).
# Production (guru-credit.com) runs with this "true": /ms/* is live and
# indexable, and the URL is the sole source of truth for language (see
# src/lib/i18n/server.ts resolveRequestLanguage). Set it "true" locally too
# so dev/CI match prod. When "true", localeHref() prefixes every internal
# Link with /ms for the Malay locale (English stays un-prefixed).
NEXT_PUBLIC_LOCALE_PREFIX_ENABLED="true"

# HMAC secret used by src/proxy.ts to sign the internal x-gc-locale/x-gc-path
# headers it carries across the /ms → / rewrite. Optional: without it the
# proxy falls back to a per-process random key, which is still fail-closed but
# would resolve /ms/* to English if the two middleware passes ever land in
# different isolates (cold start / different region). Set it once on the
# Vercel project so the signature survives multi-isolate execution. Any
# high-entropy string, e.g. `openssl rand -base64 32`. Not NEXT_PUBLIC_ — it
# must never reach the client.
LOCALE_SIG_SECRET=""
